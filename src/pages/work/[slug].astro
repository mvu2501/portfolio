---
// Template case study: tạo một trang /work/<tên-file> cho mỗi file .md trong content/work/.
// Ví dụ content/work/spot-trading.md → /work/spot-trading
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseToc from '../../components/CaseToc.astro';
import CaseNav from '../../components/CaseNav.astro';
import InformationArchitecture from '../../components/InformationArchitecture.astro';
import OrderTypesMockup from '../../components/order-types/OrderTypesMockup.astro';
import AmountInput from '../../components/trading/AmountInput.astro';
import LimitPrice from '../../components/trading/LimitPrice.astro';
import PriceCanMove from '../../components/trading/PriceCanMove.astro';

export async function getStaticPaths() {
  // Xếp theo "order" để biết case study nào đứng trước/sau (dùng cho Up next / Previous)
  const works = (await getCollection('work', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order
  );
  const brief = (e?: (typeof works)[number]) => (e ? { id: e.id, title: e.data.title } : undefined);
  return works.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: brief(works[i - 1]), next: brief(works[i + 1]) },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
// Chèn component tương tác vào giữa bài: trong .md ghi <!-- demo:tên --> trên một dòng riêng,
// ở đây tách HTML tại dấu đó và đặt component tương ứng vào. Thêm demo mới: import ở trên rồi thêm vào DEMOS.
const DEMOS: Record<string, any> = {
  'information-architecture': InformationArchitecture,
  'order-types': OrderTypesMockup,
  'amount-input': AmountInput,
  'limit-price': LimitPrice,
  'price-can-move': PriceCanMove,
};
const html = entry.rendered?.html ?? '';
const segments = /<!-- demo:[a-z-]+ -->/.test(html) ? html.split(/<!-- demo:([a-z-]+) -->/) : null;
const { title, role, year, platform, tags, description } = entry.data;
// Khối thông tin dưới tiêu đề: chỉ hiện mục nào có dữ liệu
const info = [
  { label: 'Role', value: role },
  { label: 'Year', value: year },
  { label: 'Platform', value: platform },
].filter((item) => item.value);
---

<BaseLayout title={`${title} · vunguyen.me`} description={description}>
  <header class="case-header section">
    <div class="container">
      <a class="case-header__back" href="/#work">← Work</a>
      <h1 class="case-header__title">{title}</h1>
      <p class="case-header__desc">{description}</p>
      {tags.length > 0 && (
        <ul class="case-header__tags">
          {tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}

      <dl class="case-info">
        {info.map((item) => (
          <div class="case-info__item">
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </header>

  <!-- Thanh mục lục ngang cho mobile (ẩn trên desktop) -->
  <CaseToc variant="bar" />

  <div class="container case-layout">
    <!-- Sidebar mục lục cho desktop (ẩn trên mobile) -->
    <aside class="case-layout__side">
      <!-- Nút quay lại: ẩn lúc đầu trang (đã có nút ở phần tiêu đề), hiện ra khi cuộn qua nó -->
      <a class="case-layout__back" href="/#work" tabindex="-1" aria-hidden="true">← Work</a>
      <CaseToc variant="sidebar" />
    </aside>

    <div class="case-main">
      <article class="case-body">
        {segments ? (
          segments.map((seg, i) => {
            const Demo = DEMOS[seg];
            return i % 2 === 0 ? <Fragment set:html={seg} /> : Demo ? <Demo /> : null;
          })
        ) : (
          <Content />
        )}
      </article>
      <CaseNav prev={prev} next={next} />
    </div>
  </div>
</BaseLayout>

<script>
  // Đánh dấu mục đang đọc trong mục lục khi cuộn trang.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const headings = links
    .map((a) => document.getElementById(a.dataset.tocLink ?? ''))
    .filter((el): el is HTMLElement => el !== null);
  // Lấy theo thứ tự xuất hiện, bỏ trùng (sidebar và thanh ngang cùng trỏ vào một id)
  const ids = Array.from(new Set(headings.map((h) => h.id)));

  function update() {
    // Mục đang đọc = tiêu đề cuối cùng đã cuộn qua đường mốc cách đỉnh trang ~35% màn hình
    const line = window.innerHeight * 0.35;
    let activeId = ids[0];
    for (const id of ids) {
      if (document.getElementById(id)!.getBoundingClientRect().top <= line) activeId = id;
    }
    // Cuộn chạm đáy trang thì chọn mục cuối
    if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
      activeId = ids[ids.length - 1];
    }
    for (const a of links) {
      const on = a.dataset.tocLink === activeId;
      if (on) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
      // Thanh ngang trên mobile: cuộn để mục đang đọc luôn nằm trong tầm nhìn
      if (on && a.closest('.toc--bar') && a.offsetParent !== null) {
        const bar = a.closest<HTMLElement>('.toc--bar')!;
        bar.scrollTo({ left: a.offsetLeft - 16, behavior: 'smooth' });
      }
    }
  }

  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    },
    { passive: true }
  );
  window.addEventListener('resize', update);
  update();

  // Nút "← Work" trong sidebar: hiện khi nút ở phần tiêu đề đã cuộn khuất sau thanh Nav.
  const headerBack = document.querySelector('.case-header__back');
  const sideBack = document.querySelector<HTMLElement>('.case-layout__back');
  if (headerBack && sideBack) {
    new IntersectionObserver(
      ([entry]) => {
        const show = !entry.isIntersecting;
        sideBack.classList.toggle('is-visible', show);
        sideBack.tabIndex = show ? 0 : -1;
        sideBack.setAttribute('aria-hidden', String(!show));
      },
      { rootMargin: '-64px 0px 0px 0px' } // 64px = chiều cao thanh Nav
    ).observe(headerBack);
  }
</script>

<style>
  .case-header {
    padding-bottom: var(--space-4);
  }

  .case-header__back,
  .case-layout__back {
    display: inline-block;
    margin-bottom: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .case-header__back:hover,
  .case-layout__back:hover {
    color: var(--color-text);
  }

  .case-header__title {
    font-size: var(--text-display);
    line-height: 1.22;
    margin-bottom: var(--space-2);
  }

  .case-header__desc {
    font-size: var(--text-lg);
    max-width: var(--reading-width);
  }

  /* Khối thông tin: Role / Year / Platform */
  .case-info {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    margin: var(--space-4) 0 0;
  }

  .case-info__item {
    margin: 0;
  }

  .case-info dt {
    margin-bottom: var(--spacing-xs);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .case-info dd {
    margin: 0;
  }

  .case-layout {
    display: block;
    padding-block: var(--space-4) var(--space-5);
  }

  /* Chữ trong bài giữ độ rộng dễ đọc (42rem). Khối nào cần rộng hơn thì thêm class "wide":
     khối đó trải hết cột nội dung (như hàng 3 ảnh ở mục Research). */
  .case-body {
    max-width: none;
  }

  .case-body > :global(*) {
    max-width: var(--reading-width);
  }

  .case-body > :global(.wide) {
    max-width: none;
  }

  /* Đường kẻ phân chia các phần nhỏ trong Research; trải hết cột (kể cả khi các khối demo rộng hơn cột chữ) */
  .case-body :global(hr) {
    max-width: none;
    margin: var(--space-5) 0;
    border: 0;
    border-top: 1px solid var(--color-tint-strong);
  }

  .case-body :global(hr + .td) {
    margin-top: 0;
  }

  .case-body :global(p + .td) {
    margin-top: var(--space-4);
  }

  /* Ghi chú nằm trong khung nền xám nhẹ (ví dụ: "We did not test with real clients…") */
  .case-body :global(.note) {
    margin: var(--space-5) 0 var(--space-3);
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    border-radius: var(--radius-xs);
  }

  .case-body :global(.note p) {
    margin: 0;
  }

  /* Hàng 3 phần có ảnh minh họa (ảnh trên, chữ dưới) */
  .case-body :global(.triptych) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }

  .case-body :global(.triptych figure) {
    margin: 0;
  }

  .case-body :global(.triptych img) {
    width: 100%;
    margin: 0;
  }

  .case-body :global(.triptych figcaption) {
    margin-top: var(--spacing-sm);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  .case-body :global(.triptych strong) {
    display: block;
    margin-bottom: var(--spacing-xxs);
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text);
  }

  /* Mobile: mỗi phần là một hàng ngang, ảnh nhỏ bên trái, chữ bên phải */
  @media (max-width: 39.99rem) {
    .case-body :global(.triptych) {
      grid-template-columns: 1fr;
    }

    .case-body :global(.triptych figure) {
      display: grid;
      grid-template-columns: 38% 1fr;
      gap: var(--space-2);
      align-items: center;
    }

    .case-body :global(.triptych figcaption) {
      margin-top: 0;
    }
  }

  /* Cột chứa bài viết và phần Up next / Previous (Up next rộng hơn chữ bài viết) */
  .case-main {
    min-width: 0;
  }

  /* Sidebar chỉ có trên desktop; nút Work ẩn (nhưng vẫn giữ chỗ) cho tới khi cuộn qua nút ở tiêu đề */
  .case-layout__side {
    display: none;
  }

  .case-layout__back {
    margin-bottom: var(--space-2);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s;
  }

  .case-layout__back.is-visible {
    opacity: 1;
    visibility: visible;
  }

  /* Nội dung Markdown được tạo ra lúc build nên cần :global để style tác động tới nó */
  /* Heading trong case study: 24px mobile, 28px desktop (riêng cho trang này, không đổi Heading chung) */
  .case-body :global(h2) {
    font-size: 1.5rem;
    margin-top: var(--space-5);
  }

  @media (min-width: 48rem) {
    .case-body :global(h2) {
      font-size: 1.75rem;
      margin-top: var(--space-6);
    }
  }

  .case-body :global(h2:first-child) {
    margin-top: 0;
  }

  .case-body :global(h3) {
    font-size: var(--text-lg);
    font-weight: 500;
    margin-top: var(--space-4);
  }

  /* Tiêu đề cấp 4 (các quyết định trong Trade-offs, tiêu đề của mockup trong Solution) */
  .case-body :global(h4) {
    margin: var(--space-3) 0 var(--spacing-xs);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: normal;
  }

  .case-body :global(h2 + h3) {
    margin-top: var(--space-2);
  }

  /* Danh sách (gạch đầu dòng và đánh số) */
  .case-body :global(ul),
  .case-body :global(ol) {
    margin: 0 0 var(--space-2);
    padding-left: var(--space-3);
  }

  .case-body :global(li) {
    margin-bottom: var(--spacing-xs);
  }

  .case-body :global(li > ul) {
    margin-top: var(--spacing-xs);
  }

  /* Ảnh trong bài: rộng bằng cột chữ, bo góc 14px giống ảnh cover ở thẻ */
  .case-body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 14px;
    margin-block: var(--space-3);
  }

  .case-body :global(a) {
    text-underline-offset: 3px;
  }

  /* Ghi chú hướng dẫn (dòng bắt đầu bằng ">") */
  .case-body :global(blockquote) {
    margin: 0 0 var(--space-3);
    padding: var(--spacing-xs) var(--space-2);
    border-left: 1px solid var(--color-tint-strong);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .case-body :global(blockquote p) {
    margin: 0;
  }

  /* Khối Outcome: 4 khung (do src/plugins/rehype-outcome.mjs tạo ra) */
  .case-body :global(.outcome-grid) {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .case-body :global(.outcome-card) {
    padding: var(--space-3);
    background: var(--color-surface);
    border-radius: var(--radius-none);
  }

  .case-body :global(.outcome-card h3) {
    margin-top: 0;
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .case-body :global(.outcome-card blockquote) {
    border-left: 0;
    padding: 0;
    margin: 0;
  }

  @media (min-width: 40rem) {
    .case-body :global(.outcome-grid) {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Desktop: sidebar bên trái + nội dung bên phải */
  @media (min-width: 64rem) {
    .case-layout {
      display: grid;
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--space-5);
      align-items: start;
    }

    /* Cột sidebar dính: phải đặt sticky ở chính cột (cao bằng cả bài), không phải ở mục lục bên trong */
    .case-layout__side {
      display: block;
      position: sticky;
      top: calc(var(--nav-height) + var(--space-4));
    }
  }
</style>
