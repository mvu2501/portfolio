---
// Trang chủ. Thứ tự từ trên xuống: Hero → Selected works → Fun projects.
// (Khung trò chơi duck-football đang tạm tắt, xem đoạn chú thích bên dưới để bật lại.)
// (Nav và Footer đã có sẵn trong BaseLayout.)
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Lấy các file .md trong content/work và content/fun, bỏ dự án draft, xếp theo "order".
const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;
const works = (await getCollection('work', ({ data }) => !data.draft)).sort(byOrder);
const funs = (await getCollection('fun', ({ data }) => !data.draft)).sort(byOrder);
---

<BaseLayout>
  <!-- 1. HERO -->
  <section class="hero section">
    <div class="container">
      <!-- THAY: câu định vị của bạn (1–2 dòng) -->
      <h1 class="hero__title">
        Senior Product Designer · 10+ years building fintech and digital asset products
      </h1>
      <a class="button" href="#work">View work</a>
    </div>
  </section>

  <!-- KHỐI INTERACTIVE (đang tắt). Khi có trò chơi: bỏ dấu comment ở khối dưới
       và thêm lại CSS .interactive (xem README).
  <section class="container interactive">
    <div id="duck-football" class="interactive__frame"></div>
  </section>
  -->

  <!-- 2. SELECTED WORKS / FUN PROJECTS: hai tab cạnh nhau -->
  <section id="work" class="section">
    <div class="container" data-tabs>
      <div class="tabs__list" role="tablist" aria-label="Projects">
        <button class="tabs__tab" role="tab" id="tab-work" aria-controls="panel-work" aria-selected="true">
          Selected works
        </button>
        {funs.length > 0 && (
          <button class="tabs__tab" role="tab" id="tab-fun" aria-controls="panel-fun" aria-selected="false">
            Fun projects
          </button>
        )}
      </div>

      <div class="tabs__panel" role="tabpanel" id="panel-work" aria-labelledby="tab-work">
        <div class="grid grid--work">
          {works.map((w) => (
            <ProjectCard
              title={w.data.title}
              tags={w.data.tags}
              description={w.data.description}
              cover={w.data.cover}
              coverAlt={w.data.coverAlt}
              href={`/work/${w.id}`}
            />
          ))}
        </div>
      </div>

      {funs.length > 0 && (
        <div class="tabs__panel" role="tabpanel" id="panel-fun" aria-labelledby="tab-fun">
          <div class="grid grid--fun">
            {funs.map((f) => (
              <ProjectCard
                title={f.data.title}
                tags={f.data.tags}
                description={f.data.description}
                cover={f.data.cover}
                coverAlt={f.data.coverAlt}
                href={f.data.link}
                external={!!f.data.link}
              />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // Tab Selected works / Fun projects. Không có JavaScript thì hai khối cùng hiện, xếp dọc.
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls') ?? '')!);

    function select(index: number, focus = false) {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
        if (on && focus) tab.focus();
      });
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const current = tabs.indexOf(tab);
        const next =
          e.key === 'ArrowRight' ? (current === last ? 0 : current + 1)
          : e.key === 'ArrowLeft' ? (current === 0 ? last : current - 1)
          : e.key === 'Home' ? 0
          : e.key === 'End' ? last
          : -1;
        if (next >= 0) {
          e.preventDefault();
          select(next, true);
        }
      });
    });

    // Link /#work (Nav) mở tab Selected works; link /#fun mở tab Fun projects.
    function fromHash() {
      const index = location.hash === '#fun' && tabs.length > 1 ? 1 : 0;
      select(index);
      if (location.hash === '#fun') document.getElementById('work')?.scrollIntoView();
    }
    window.addEventListener('hashchange', fromHash);
    fromHash();
  }
</script>

<style>
  .hero {
    padding-bottom: var(--space-4);
  }

  .hero__title {
    font-size: var(--text-display);
    line-height: 1.22;
    max-width: 20ch;
    margin-bottom: var(--space-3);
  }

  /* Tab: chữ mono nhỏ viết hoa, tab đang chọn có chữ mực và vạch đỏ gạch bên dưới */
  .tabs__list {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .tabs__tab {
    min-height: 32px;
    padding: var(--spacing-xs) 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.15s;
  }

  .tabs__tab:hover {
    color: var(--color-text);
  }

  .tabs__tab[aria-selected='true'] {
    color: var(--color-text);
    border-bottom-color: var(--color-hairline);
  }

  .tabs__panel[hidden] {
    display: none;
  }

  /* Khi không có JavaScript, hai khối cùng hiện nên cách nhau ra */
  .tabs__panel + .tabs__panel {
    margin-top: var(--space-5);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4) var(--space-3);
  }

  /* Selected works: tối đa 2 thẻ/hàng. Fun projects: 3 thẻ/hàng. */
  @media (min-width: 40rem) {
    .grid--work {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5) var(--space-4);
    }

  }

  /* Fun projects: 3 thẻ/hàng từ màn hình tablet trở lên */
  @media (min-width: 48rem) {
    .grid--fun {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5) var(--space-3);
    }
  }
</style>
