---
// Trang chủ. Thứ tự từ trên xuống: Hero → Duck Football → Selected works → Fun projects.
// (Nav và Footer đã có sẵn trong BaseLayout.)
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import DuckFootball from '../components/DuckFootball.astro';

// Lấy các file .md trong content/work và content/fun, bỏ dự án draft, xếp theo "order".
const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;
const works = (await getCollection('work', ({ data }) => !data.draft)).sort(byOrder);
const funs = (await getCollection('fun', ({ data }) => !data.draft)).sort(byOrder);
---

<BaseLayout>
  <!-- 1. HERO -->
  <section class="hero section">
    <div class="container">
      <!-- THAY: câu định vị của bạn. Avatar nằm ngay sau chữ "Vu"; rê chuột vào (hoặc chạm) để avatar nảy lên và có ánh sáng quét qua -->
      <h1 class="hero__title">
        <span class="hero__line">Hey, it’s Vu<span class="avatar" data-avatar aria-hidden="true"><span class="avatar__clip"><img class="avatar__img avatar__img--anim" src="/images/avatar-vu.gif" width="220" height="220" alt="" decoding="async" draggable="false" /><img class="avatar__img avatar__img--still" src="/images/avatar-vu-still.webp" width="220" height="220" alt="" decoding="async" draggable="false" /><span class="avatar__shine"></span></span></span>, a senior product designer for Web3 and fintech.</span>{' '}
        <span class="hero__line">I turn complex money movement into clear, trustworthy products.</span>
      </h1>
      <a class="button" href="#work">View work</a>
    </div>
  </section>

  <!-- 2. DUCK FOOTBALL: trò chơi nhỏ ngay dưới hero (code ở src/components/DuckFootball.astro) -->
  <section class="container interactive">
    <DuckFootball />
  </section>

  <!-- 2. SELECTED WORKS / FUN PROJECTS: hai tab cạnh nhau -->
  <section id="work" class="section">
    <div class="container" data-tabs>
      <div class="tabs__list" role="tablist" aria-label="Projects">
        <button class="tabs__tab" role="tab" id="tab-work" aria-controls="panel-work" aria-selected="true">
          Selected works
        </button>
        {funs.length > 0 && (
          <button class="tabs__tab" role="tab" id="tab-fun" aria-controls="panel-fun" aria-selected="false">
            Fun projects
          </button>
        )}
      </div>

      <div class="tabs__panel" role="tabpanel" id="panel-work" aria-labelledby="tab-work">
        <div class="grid grid--work">
          {works.map((w) => (
            <ProjectCard
              title={w.data.title}
              tags={w.data.tags}
              description={w.data.description}
              cover={w.data.cover}
              coverAlt={w.data.coverAlt}
              href={`/work/${w.id}`}
            />
          ))}
        </div>
      </div>

      {funs.length > 0 && (
        <div class="tabs__panel" role="tabpanel" id="panel-fun" aria-labelledby="tab-fun">
          <div class="grid grid--fun">
            {funs.map((f) => (
              <ProjectCard
                title={f.data.title}
                tags={f.data.tags}
                description={f.data.description}
                cover={f.data.cover}
                coverAlt={f.data.coverAlt}
                href={f.data.demo ? `/fun-projects/${f.id}` : f.data.link}
                external={!f.data.demo && !!f.data.link}
              />
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // Avatar ở dòng chào: bấm/chạm để chạy lại hiệu ứng (trên điện thoại không có hover).
  document.querySelectorAll<HTMLElement>('[data-avatar]').forEach((el) => {
    el.addEventListener('click', () => {
      el.classList.remove('is-active');
      void el.offsetWidth; // khởi động lại hoạt ảnh
      el.classList.add('is-active');
    });
    el.addEventListener('animationend', (e) => {
      if (e.target === el) el.classList.remove('is-active');
    });
  });
</script>

<script>
  // Tab Selected works / Fun projects. Không có JavaScript thì hai khối cùng hiện, xếp dọc.
  const root = document.querySelector<HTMLElement>('[data-tabs]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls') ?? '')!);

    function select(index: number, focus = false) {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
        if (on && focus) tab.focus();
      });
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const current = tabs.indexOf(tab);
        const next =
          e.key === 'ArrowRight' ? (current === last ? 0 : current + 1)
          : e.key === 'ArrowLeft' ? (current === 0 ? last : current - 1)
          : e.key === 'Home' ? 0
          : e.key === 'End' ? last
          : -1;
        if (next >= 0) {
          e.preventDefault();
          select(next, true);
        }
      });
    });

    // Link /#work (Nav) mở tab Selected works; link /#fun mở tab Fun projects.
    function fromHash() {
      const index = location.hash === '#fun' && tabs.length > 1 ? 1 : 0;
      select(index);
      if (location.hash === '#fun') document.getElementById('work')?.scrollIntoView();
    }
    window.addEventListener('hashchange', fromHash);
    fromHash();
  }
</script>

<style>
  .hero {
    padding-bottom: var(--space-4);
  }

  .hero__title {
    font-size: var(--text-display);
    line-height: 1.22;
    max-width: 26ch;
    margin-bottom: var(--space-3);
  }

  /* Hai câu, mỗi câu bắt đầu một dòng mới */
  .hero__line {
    display: block;
  }

  /* Avatar tròn nằm trong dòng chữ; nảy lên + ánh sáng quét qua khi rê chuột (hoặc chạm) */
  .avatar {
    position: relative;
    top: -0.06em;
    display: inline-block;
    width: 0.92em;
    height: 0.92em;
    margin: 0 0.1em;
    vertical-align: middle;
    cursor: pointer;
    transform-origin: 50% 90%;
    filter: drop-shadow(0 0.03em 0.05em rgba(60, 40, 10, 0.22));
  }

  .avatar__clip {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
    border-radius: 50%;
  }

  /* Phóng nhẹ và dịch ảnh để mặt nhân vật nằm giữa vòng tròn */
  .avatar__img {
    position: absolute;
    top: -10%;
    left: -22%;
    display: block;
    width: 122%;
    max-width: none;
    height: 122%;
    margin: 0;
    border-radius: 0;
    user-select: none;
  }

  .avatar__img--still {
    display: none;
  }

  .avatar__shine {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 70%;
    background: linear-gradient(105deg, transparent, rgba(255, 255, 255, 0.8), transparent);
    opacity: 0;
    transform: translateX(-120%);
    pointer-events: none;
  }

  .avatar:hover,
  .avatar.is-active {
    animation: avatar-bounce 0.7s cubic-bezier(0.3, 0.7, 0.4, 1);
  }

  .avatar:hover .avatar__shine,
  .avatar.is-active .avatar__shine {
    animation: avatar-shine 0.7s ease-out 0.08s;
  }

  @keyframes avatar-bounce {
    0% { transform: translateY(0) scale(1, 1); }
    16% { transform: translateY(0) scale(1.08, 0.88); }
    42% { transform: translateY(-0.3em) scale(0.94, 1.1) rotate(-5deg); }
    68% { transform: translateY(0) scale(1.07, 0.92); }
    84% { transform: translateY(-0.07em) scale(0.98, 1.03) rotate(2deg); }
    100% { transform: translateY(0) scale(1, 1); }
  }

  @keyframes avatar-shine {
    0% { opacity: 0; transform: translateX(-120%); }
    15% { opacity: 1; }
    100% { opacity: 0; transform: translateX(220%); }
  }

  /* Người dùng tắt chuyển động: không nảy, không quét sáng, dùng ảnh tĩnh thay cho GIF */
  @media (prefers-reduced-motion: reduce) {
    .avatar:hover,
    .avatar.is-active,
    .avatar:hover .avatar__shine,
    .avatar.is-active .avatar__shine {
      animation: none;
    }

    .avatar__img--anim {
      display: none;
    }

    .avatar__img--still {
      display: block;
    }
  }

  /* Tab: chữ mono nhỏ viết hoa, tab đang chọn có chữ mực và vạch đỏ gạch bên dưới */
  .tabs__list {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .tabs__tab {
    min-height: 32px;
    padding: var(--spacing-xs) 0;
    border: 0;
    border-bottom: 1px solid transparent;
    background: none;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.15s;
  }

  .tabs__tab:hover {
    color: var(--color-text);
  }

  .tabs__tab[aria-selected='true'] {
    color: var(--color-text);
    border-bottom-color: var(--color-hairline);
  }

  .tabs__panel[hidden] {
    display: none;
  }

  /* Khi không có JavaScript, hai khối cùng hiện nên cách nhau ra */
  .tabs__panel + .tabs__panel {
    margin-top: var(--space-5);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4) var(--space-3);
  }

  /* Selected works: tối đa 2 thẻ/hàng. Fun projects: 3 thẻ/hàng. */
  @media (min-width: 40rem) {
    .grid--work {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-5) var(--space-4);
    }

  }

  /* Fun projects: 3 thẻ/hàng từ màn hình tablet trở lên */
  @media (min-width: 48rem) {
    .grid--fun {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-5) var(--space-3);
    }
  }
</style>
