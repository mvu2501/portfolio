---
// Trang chủ. Thứ tự từ trên xuống: Hero → Selected works → Fun projects.
// (Khung trò chơi duck-football đang tạm tắt, xem đoạn chú thích bên dưới để bật lại.)
// (Nav và Footer đã có sẵn trong BaseLayout.)
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Lấy các file .md trong content/work và content/fun, bỏ dự án draft, xếp theo "order".
const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) =>
  a.data.order - b.data.order;
const works = (await getCollection('work', ({ data }) => !data.draft)).sort(byOrder);
const funs = (await getCollection('fun', ({ data }) => !data.draft)).sort(byOrder);
---

<BaseLayout>
  <!-- 1. HERO -->
  <section class="hero section">
    <div class="container">
      <!-- THAY: câu định vị của bạn (1–2 dòng) -->
      <h1 class="hero__title">
        Senior Product Designer · 10+ years building fintech and digital asset products
      </h1>
      <a class="button" href="#work">View work</a>
    </div>
  </section>

  <!-- KHỐI INTERACTIVE (đang tắt). Khi có trò chơi: bỏ dấu comment ở khối dưới
       và thêm lại CSS .interactive (xem README).
  <section class="container interactive">
    <div id="duck-football" class="interactive__frame"></div>
  </section>
  -->

  <!-- 2. SELECTED WORKS -->
  <section id="work" class="section">
    <div class="container">
      <p class="eyebrow">Selected works</p>
      <div class="grid grid--work">
        {works.map((w) => (
          <ProjectCard {...w.data} href={`/work/${w.id}`} />
        ))}
      </div>
    </div>
  </section>

  <!-- 3. FUN PROJECTS -->
  <section id="fun" class="section section--tight">
    <div class="container">
      <p class="eyebrow">Fun projects</p>
      <div class="grid grid--fun">
        {funs.map((f) => (
          <ProjectCard
            {...f.data}
            compact
            href={f.data.link}
            external={!!f.data.link}
          />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-bottom: var(--space-4);
  }

  .hero__title {
    font-size: var(--text-hero);
    max-width: 20ch;
    margin-bottom: var(--space-3);
  }

  .section--tight {
    padding-top: 0;
  }

  .grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .grid--work {
      grid-template-columns: repeat(2, 1fr);
    }

    .grid--fun {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .grid--fun {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
