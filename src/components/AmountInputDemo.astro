---
// AmountInputDemo.astro – khung xám so sánh Version 1 → Improved (bố cục theo ảnh tham khảo của Vu).
import TradeTicket from './TradeTicket.astro';
---

<div class="demo wide">
  <div class="demo__col">
    <span class="chip chip--outline">Version 1</span>
    <div class="demo__ticket"><TradeTicket variant="v1" /></div>
    <p class="demo__caption">Amount in BTC only.</p>
  </div>

  <span class="demo__arrow" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h16M14 6l6 6-6 6"></path></svg>
  </span>

  <div class="demo__col">
    <span class="chip chip--solid">Improved</span>
    <div class="demo__ticket"><TradeTicket variant="improved" /></div>
    <p class="demo__caption">Tap the switch to type in BTC or USDT.</p>
  </div>
</div>

<style>
  .demo {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: start;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-3);
    border-radius: 16px;
    background: #f5f7f9;
    margin: var(--space-3) 0 0;
  }

  .demo__col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }

  .demo__ticket {
    width: 100%;
    max-width: 300px;
  }

  .demo__arrow {
    align-self: center;
    color: #1eb5a4;
    display: grid;
    place-items: center;
  }

  .demo__caption {
    margin: 0;
    max-width: 30ch;
    text-align: center;
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .chip {
    padding: 4px 12px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .chip--outline {
    border: 1px solid #b9c2cb;
    color: #4e5964;
  }

  .chip--solid {
    background: #0c766b;
    color: #fff;
    border: 1px solid #0c766b;
  }

  @media (max-width: 47.99rem) {
    .demo {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .demo__arrow {
      transform: rotate(90deg);
    }
  }
</style>
