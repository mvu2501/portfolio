---
// ReverseDoubleDiamond.astro – sơ đồ design process "Reverse Double Diamond".
// Màn hình rộng: sơ đồ SVG. Màn hình hẹp (< 48rem): danh sách 4 bước (chữ trong SVG sẽ quá nhỏ).
// Sửa chữ ở mảng `steps` bên dưới.
const steps = [
  { n: 1, name: 'Explore', phase: 'Before launch', mode: 'Diverge', cap: ['Leadership builds', 'confidence in', 'the idea'], text: 'Leadership builds confidence in the idea.' },
  { n: 2, name: 'Deliver', phase: 'Before launch', mode: 'Converge', cap: ['Designer', 'delivers', 'the idea'], text: 'Designer delivers the idea.' },
  { n: 3, name: 'Insight', phase: 'After launch', mode: 'Diverge', cap: ['Team checks', 'whether the idea', 'is working'], text: 'Team checks whether the idea is working.' },
  { n: 4, name: 'Improve', phase: 'After launch', mode: 'Converge', cap: ['Team adds,', 'improves', 'or pivots'], text: 'Team adds, improves or pivots.' },
];
// Hai hình thoi: tâm và nửa đường chéo trong hệ toạ độ viewBox 1100 × 440
const R = 150;
const cy = 210;
const centers = [370, 750];
---

<figure class="rdd">
  <svg class="rdd__svg" viewBox="0 0 1100 440" role="img" aria-label="Reverse Double Diamond: Explore and Deliver before launch, then Insight and Improve after launch, then iterate.">
    <line class="rdd__line" x1="128" y1={cy} x2={centers[0] - R} y2={cy} />
    <line class="rdd__line" x1={centers[0] + R} y1={cy} x2={centers[1] - R} y2={cy} />
    <line class="rdd__line" x1={centers[1] + R} y1={cy} x2="1010" y2={cy} />

    <circle class="rdd__start" cx="118" cy={cy} r="8" />
    <text class="rdd__side" x="98" y={cy - 6} text-anchor="end">Solution</text>
    <text class="rdd__side" x="98" y={cy + 14} text-anchor="end">to problem</text>

    <circle class="rdd__halo" cx="560" cy={cy} r="16" />
    <circle class="rdd__dot" cx="560" cy={cy} r="9" />
    <text class="rdd__side" x="560" y={cy + 44} text-anchor="middle">Launch</text>

    <path class="rdd__arrow" d={`M1010 ${cy - 8} L1022 ${cy} L1010 ${cy + 8}`} />
    <text class="rdd__side" x="1040" y={cy + 5}>Iterate</text>

    {[0, 1].map((d) => {
      const c = centers[d];
      const [a, b] = [steps[d * 2], steps[d * 2 + 1]];
      return (
        <g>
          <text class="rdd__phase" x={c} y="30" text-anchor="middle">{a.phase.toUpperCase()}</text>
          <path class="rdd__half rdd__half--left" d={`M${c} ${cy - R} L${c - R} ${cy} L${c} ${cy + R} Z`} />
          <path class="rdd__half rdd__half--right" d={`M${c} ${cy - R} L${c + R} ${cy} L${c} ${cy + R} Z`} />
          <path class="rdd__edge" d={`M${c} ${cy - R} L${c + R} ${cy} L${c} ${cy + R} L${c - R} ${cy} Z`} />
          <line class="rdd__split" x1={c} y1={cy - R} x2={c} y2={cy + R} />
          <text class="rdd__mode" transform={`translate(${c - 84} ${cy - 92}) rotate(-45)`} text-anchor="middle">{a.mode.toUpperCase()}</text>
          <text class="rdd__mode" transform={`translate(${c + 84} ${cy - 92}) rotate(45)`} text-anchor="middle">{b.mode.toUpperCase()}</text>
          <text class="rdd__num" x={c - 74} y={cy - 22} text-anchor="middle">{a.n}</text>
          <text class="rdd__name" x={c - 74} y={cy + 10} text-anchor="middle">{a.name}</text>
          <text class="rdd__num" x={c + 74} y={cy - 22} text-anchor="middle">{b.n}</text>
          <text class="rdd__name" x={c + 74} y={cy + 10} text-anchor="middle">{b.name}</text>
          {[a, b].map((st, k) => {
            const px = k === 0 ? c - 38 : c + 38;
            const capX = k === 0 ? c - 78 : c + 82;
            return (
              <g>
                <circle class="rdd__pin" cx={px} cy={cy + 76} r="5" />
                <line class="rdd__leader" x1={px} y1={cy + 81} x2={capX} y2={cy + 170} />
                <circle class="rdd__pin-end" cx={capX} cy={cy + 170} r="2.5" />
                {st.cap.map((line, li) => (
                  <text class="rdd__cap" x={capX} y={cy + 192 + li * 17} text-anchor="middle">{line}</text>
                ))}
              </g>
            );
          })}
        </g>
      );
    })}
  </svg>

  <ol class="rdd__list">
    {steps.map((s) => (
      <li class="rdd__item">
        <span class="rdd__item-num">{String(s.n).padStart(2, '0')}</span>
        <h3 class="rdd__item-name">{s.name}</h3>
        <p class="rdd__item-meta">{s.phase} · {s.mode}</p>
        <p class="rdd__item-text">{s.text}</p>
      </li>
    ))}
  </ol>
  <figcaption class="sr-only">Start from the solution to a problem, explore and deliver before launch, then gather insight and improve after launch, and iterate.</figcaption>
</figure>

<style>
  .rdd {
    margin: 0;
  }

  .rdd__svg {
    display: none;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .rdd__line,
  .rdd__arrow,
  .rdd__edge,
  .rdd__split {
    fill: none;
    stroke: var(--color-text);
  }

  .rdd__line {
    stroke: var(--color-tint-strong);
    stroke-width: 1.5;
  }

  .rdd__arrow {
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .rdd__edge {
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .rdd__split {
    stroke: var(--color-tint-strong);
    stroke-width: 1;
  }

  .rdd__half--left {
    fill: #fff;
  }

  .rdd__half--right {
    fill: var(--color-tint);
  }

  .rdd__start {
    fill: var(--color-bg);
    stroke: var(--color-text);
    stroke-width: 1.5;
  }

  .rdd__halo {
    fill: var(--color-accent);
    opacity: 0.15;
  }

  .rdd__dot {
    fill: var(--color-accent);
  }

  .rdd__side {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    fill: var(--color-text);
  }

  .rdd__phase,
  .rdd__mode {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    fill: var(--color-accent);
  }

  .rdd__mode {
    font-size: 9.5px;
    fill: var(--color-text-muted);
  }

  .rdd__num {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--color-accent);
  }

  .rdd__name {
    font-family: var(--font-sans);
    font-size: 25px;
    letter-spacing: var(--tracking-display);
    fill: var(--color-text);
  }

  .rdd__pin {
    fill: #fff;
    stroke: var(--color-accent);
    stroke-width: 1.5;
  }

  .rdd__leader {
    stroke: var(--color-accent);
    stroke-width: 1.2;
  }

  .rdd__pin-end {
    fill: var(--color-accent);
  }

  .rdd__cap {
    font-family: var(--font-sans);
    font-size: 14px;
    fill: var(--color-text-muted);
  }

  .rdd__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .rdd__item {
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-tint-strong);
  }

  .rdd__item-num {
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    letter-spacing: 0.14em;
    color: var(--color-accent);
  }

  .rdd__item-name {
    margin: var(--spacing-xxs) 0;
    font-size: var(--text-heading);
  }

  .rdd__item-meta {
    margin: 0 0 var(--spacing-xs);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .rdd__item-text {
    margin: 0;
    color: var(--color-text-muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (min-width: 48rem) {
    .rdd__svg {
      display: block;
    }

    .rdd__list {
      display: none;
    }
  }
</style>
