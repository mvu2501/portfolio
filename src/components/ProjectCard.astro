---
// ProjectCard.astro – thẻ dự án theo thiết kế Figma:
// cover → tên dự án (+ mũi tên) → tag → mô tả ngắn.
// Dùng cho cả Selected works (2 thẻ/hàng) và Playaround (2 thẻ/hàng).

interface Props {
  title: string;
  tags: string[];
  description?: string; // không có thì không hiện mô tả (Playaround)
  cover?: string;      // đường dẫn ảnh trong public/, ví dụ /images/work/spot-trading-cover.webp
  coverAlt?: string;
  href?: string;       // nếu có: cả thẻ bấm được
  external?: boolean;  // true: mở link ở tab mới
  demo?: string;       // có: thẻ là nút, bấm mở popup chứa demo này (xem index.astro)
}

const { title, tags, description, cover, coverAlt = '', href, external = false, demo } = Astro.props;
const Tag = demo ? 'button' : href ? 'a' : 'div';
const linkProps = demo
  ? { type: 'button', 'data-demo': demo, 'data-title': title }
  : href
  ? { href, ...(external ? { target: '_blank', rel: 'noopener' } : {}) }
  : {};
---

<Tag class:list={['card', { 'card--link': !!(href || demo), 'card--button': !!demo }]} {...linkProps}>
  <div class="card__cover">
    {cover && <img src={cover} alt={coverAlt} loading="lazy" decoding="async" />}
  </div>
  <div class="card__body">
    <h3 class="card__title">
      {title}
      {(href || demo) && <span class="card__arrow" aria-hidden="true">→</span>}
    </h3>
    {tags.length > 0 && (
      <ul class="card__tags">
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )}
    {description && <p class="card__desc">{description}</p>}
  </div>
</Tag>

<style>
  .card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  /* Cover: tỉ lệ 487 : 314, bo 14px, viền mảnh bên trong (theo Figma) */
  .card--button {
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .card__cover {
    position: relative;
    aspect-ratio: 487 / 314;
    overflow: hidden;
    border-radius: 14px;
    background: var(--color-cover);
  }

  .card__cover::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgba(31, 29, 26, 0.05);
    pointer-events: none;
  }

  .card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .card--link:hover .card__cover img {
    transform: scale(1.02);
  }

  .card__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-sm);
    padding: 14px 2px 0;
  }

  .card__title {
    margin: 0;
    font-size: 0.9375rem; /* 15px */
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .card__arrow {
    display: inline-block;
    margin-left: var(--spacing-xs);
    color: var(--color-text-muted);
    transition: transform 0.2s ease;
  }

  .card--link:hover .card__arrow {
    transform: translateX(4px);
  }

  .card__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xxs);
  }

  .card__tags li {
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--color-tag);
    color: var(--color-text-muted);
    font-size: 0.65625rem; /* 10.5px */
    line-height: 1.3;
  }

  .card__desc {
    margin: calc(var(--spacing-xs) - var(--spacing-sm)) 0 0;
    max-width: 395px;
    color: var(--color-text-muted);
    font-size: 0.875rem; /* 14px */
    line-height: 1.55;
  }
</style>
