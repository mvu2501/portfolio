---
// TradeTicket.astro – bản vẽ lại (bằng HTML/CSS) màn hình Order form của app trong Figma "Aura Mobile v1.1".
// variant="v1":       ô Amount chỉ nhập được theo BTC.
// variant="improved": ô Amount có nút switch để nhập theo BTC hoặc USDT (tương tác bằng script bên dưới).
interface Props {
  variant: 'v1' | 'improved';
}
const { variant } = Astro.props;
const improved = variant === 'improved';
---

<div class="ticket" data-ticket={variant} data-unit="USDT" data-price="68566">
  <div class="ticket__pair">
    <span>BTC / USDT</span>
    <span class="ticket__pair-sub">Spot</span>
  </div>

  <div class="ticket__side" role="presentation">
    <span class="ticket__side-btn is-buy">Buy</span>
    <span class="ticket__side-btn">Sell</span>
  </div>

  <div class="ticket__field ticket__field--select">
    <span class="ticket__label">Order type</span>
    <span class="ticket__value">Market
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 6 4 4 4-4"></path></svg>
    </span>
  </div>

  <div class="ticket__field">
    <span class="ticket__label">Amount</span>
    {improved ? (
      <div class="ticket__amount">
        <div class="ticket__input-wrap">
          <span class="ticket__input-view" data-view aria-hidden="true">6,218.86</span>
          <input
            class="ticket__input"
            data-input
            type="text"
            inputmode="decimal"
            autocomplete="off"
            value="6,218.86"
            aria-label="Amount"
          />
        </div>
        <span class="ticket__unit" data-unit-label>USDT</span>
        <button class="ticket__switch" type="button" data-switch aria-label="Switch amount unit to BTC">
          <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h9M10.5 3.5 13 6l-2.5 2.5M12 10H3M5.5 7.5 3 10l2.5 2.5"></path></svg>
        </button>
      </div>
    ) : (
      <div class="ticket__amount">
        <span class="ticket__value ticket__value--muted">0.0000</span>
        <span class="ticket__unit">BTC</span>
      </div>
    )}
    <span class="ticket__helper" data-helper>{improved ? '≈ 0.0907 BTC' : 'Enter amount'}</span>
  </div>

  <div class="ticket__slider" aria-hidden="true">
    <span class="ticket__stop is-on"></span><span class="ticket__stop"></span><span class="ticket__stop"></span><span class="ticket__stop"></span><span class="ticket__stop"></span>
    <span class="ticket__track"></span>
  </div>

  <dl class="ticket__rows">
    <div><dt>Fee</dt><dd data-fee>{improved ? '≈ 6.22 USDT' : '--'}</dd></div>
    <div><dt>Total</dt><dd data-total>{improved ? '6,218.86 USDT' : '--'}</dd></div>
  </dl>

  <span class="ticket__cta">Buy BTC</span>

  <p class="sr-only" aria-live="polite" data-live></p>
</div>

<style>
  .ticket {
    --t-buy: #00b47d;
    --t-buy-subtle: #e6f8f2;
    --t-text: #101214;
    --t-text-2: #4e5964;
    --t-text-3: #66727f;
    --t-disabled: #a3adb8;
    --t-border: #e4e7ea;
    --t-subtle: #f2f4f5;
    --t-accent: #14b8a6;

    width: 100%;
    padding: 16px;
    border-radius: 16px;
    background: #fff;
    color: var(--t-text);
    box-shadow: 0 0 0 1px rgba(16, 18, 20, 0.06), 0 8px 24px rgba(16, 18, 20, 0.06);
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.3;
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
  }

  .ticket__pair {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-weight: 500;
    font-size: 15px;
  }

  .ticket__pair-sub {
    font-size: 11px;
    font-weight: 400;
    color: var(--t-text-3);
  }

  .ticket__side {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 2px;
    border-radius: 8px;
    background: var(--t-subtle);
  }

  .ticket__side-btn {
    padding: 6px 0;
    text-align: center;
    border-radius: 6px;
    color: var(--t-text-3);
    font-weight: 500;
  }

  .ticket__side-btn.is-buy {
    background: var(--t-buy);
    color: #fff;
  }

  .ticket__field {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 12px;
    border: 1px solid var(--t-border);
    border-radius: 8px;
  }

  .ticket__field--select {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }

  .ticket__label {
    font-size: 11px;
    color: var(--t-text-3);
  }

  .ticket__value {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 500;
  }

  .ticket__value--muted {
    color: var(--t-disabled);
    font-size: 17px;
  }

  .ticket__amount {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ticket__input-wrap {
    position: relative;
    flex: 1;
    min-width: 0;
    height: 24px;
    overflow: hidden;
  }

  /* Ô nhập thật nằm trên; lớp "view" phía sau chỉ để chạy hiệu ứng cuộn số khi bấm switch */
  .ticket__input,
  .ticket__input-view {
    position: absolute;
    inset: 0;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 17px;
    font-weight: 500;
    line-height: 24px;
    color: var(--t-text);
    outline: none;
    white-space: nowrap;
  }

  .ticket__input-view {
    visibility: hidden;
  }

  .ticket__input-wrap.is-rolling .ticket__input {
    visibility: hidden;
  }

  .ticket__input-wrap.is-rolling .ticket__input-view {
    visibility: visible;
    animation: ticket-roll 0.32s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @keyframes ticket-roll {
    0% { transform: translateY(70%); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }

  .ticket__unit {
    display: inline-block;
    font-weight: 500;
    color: var(--t-text-2);
    min-width: 3ch;
  }

  .ticket__unit.is-rolling {
    animation: ticket-roll 0.32s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .ticket__switch {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--t-border);
    border-radius: 8px;
    background: var(--t-subtle);
    color: var(--t-text);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }

  .ticket__switch:hover {
    background: var(--t-buy-subtle);
    border-color: var(--t-accent);
  }

  .ticket__switch:focus-visible {
    outline: 2px solid var(--t-accent);
    outline-offset: 2px;
  }

  .ticket__switch svg {
    transition: transform 0.32s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .ticket__switch.is-flipped svg {
    transform: rotate(180deg);
  }

  /* Vòng sáng nhấp nháy mời người xem bấm; mất đi sau lần bấm đầu tiên */
  .ticket__switch::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 12px;
    border: 2px solid var(--t-accent);
    opacity: 0;
    animation: ticket-ring 1.8s ease-out infinite;
    pointer-events: none;
  }

  .ticket[data-touched] .ticket__switch::after {
    animation: none;
  }

  @keyframes ticket-ring {
    0% { transform: scale(0.85); opacity: 0.8; }
    80%, 100% { transform: scale(1.15); opacity: 0; }
  }

  .ticket__helper {
    font-size: 11px;
    color: var(--t-text-3);
  }

  .ticket__slider {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 12px;
    padding: 0 2px;
  }

  .ticket__track {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 50%;
    height: 2px;
    transform: translateY(-50%);
    background: var(--t-border);
    z-index: 0;
  }

  .ticket__stop {
    position: relative;
    z-index: 1;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--t-border);
  }

  .ticket__stop.is-on {
    border-color: var(--t-accent);
    background: var(--t-accent);
  }

  .ticket__rows {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .ticket__rows div {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .ticket__rows dt {
    color: var(--t-text-3);
  }

  .ticket__rows dd {
    margin: 0;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .ticket__cta {
    padding: 11px 0;
    border-radius: 8px;
    background: var(--t-buy);
    color: #fff;
    text-align: center;
    font-weight: 500;
    font-size: 14px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticket__input-wrap.is-rolling .ticket__input-view,
    .ticket__unit.is-rolling,
    .ticket__switch::after {
      animation: none;
    }

    .ticket__switch svg {
      transition: none;
    }
  }
</style>

<script>
  // Tương tác của ticket "improved": bấm switch để đổi giữa nhập USDT và nhập BTC.
  const fmt = (n: number, digits: number) =>
    n.toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits });
  const parse = (s: string) => parseFloat(s.replace(/,/g, '')) || 0;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-ticket="improved"]').forEach((ticket) => {
    const price = Number(ticket.dataset.price);
    const input = ticket.querySelector<HTMLInputElement>('[data-input]')!;
    const view = ticket.querySelector<HTMLElement>('[data-view]')!;
    const wrap = input.parentElement!;
    const unitLabel = ticket.querySelector<HTMLElement>('[data-unit-label]')!;
    const btn = ticket.querySelector<HTMLButtonElement>('[data-switch]')!;
    const helper = ticket.querySelector<HTMLElement>('[data-helper]')!;
    const fee = ticket.querySelector<HTMLElement>('[data-fee]')!;
    const total = ticket.querySelector<HTMLElement>('[data-total]')!;
    const live = ticket.querySelector<HTMLElement>('[data-live]')!;

    let unit: 'USDT' | 'BTC' = 'USDT';
    // Giá trị USDT chính xác: tránh sai số làm tròn khi bấm switch qua lại
    let usdtExact = parse(input.value);

    // Tính lại các dòng bên dưới từ giá trị đang nhập
    function update() {
      const v = parse(input.value);
      const usdt = usdtExact;
      const btcAmt = usdtExact / price;
      helper.textContent = v === 0 ? 'Enter amount' : unit === 'USDT' ? `≈ ${fmt(btcAmt, 4)} BTC` : `≈ ${fmt(usdt, 2)} USDT`;
      fee.textContent = v === 0 ? '--' : `≈ ${fmt(usdt * 0.001, 2)} USDT`;
      total.textContent = v === 0 ? '--' : `${fmt(usdt, 2)} USDT`;
    }

    function roll(el: HTMLElement) {
      if (reduce) return;
      el.classList.remove('is-rolling');
      void el.offsetWidth; // khởi động lại hoạt ảnh
      el.classList.add('is-rolling');
      el.addEventListener('animationend', () => el.classList.remove('is-rolling'), { once: true });
    }

    btn.addEventListener('click', () => {
      ticket.setAttribute('data-touched', '');
      const next = unit === 'USDT' ? 'BTC' : 'USDT';
      const converted = next === 'BTC' ? usdtExact / price : usdtExact;
      input.value = usdtExact === 0 ? '' : fmt(converted, next === 'BTC' ? 4 : 2);
      unit = next;
      unitLabel.textContent = unit;
      btn.classList.toggle('is-flipped', unit === 'BTC');
      btn.setAttribute('aria-label', `Switch amount unit to ${unit === 'USDT' ? 'BTC' : 'USDT'}`);
      view.textContent = input.value;
      wrap.classList.add('is-rolling');
      if (!reduce) {
        view.addEventListener('animationend', () => wrap.classList.remove('is-rolling'), { once: true });
      } else {
        wrap.classList.remove('is-rolling');
      }
      roll(unitLabel);
      update();
      live.textContent = `Amount in ${unit}. ${helper.textContent}`;
    });

    input.addEventListener('input', () => {
      // Chỉ cho số và một dấu chấm; BTC tối đa 4 số lẻ, USDT tối đa 2
      const max = unit === 'BTC' ? 4 : 2;
      let s = input.value.replace(/[^0-9.]/g, '');
      const dot = s.indexOf('.');
      if (dot >= 0) s = s.slice(0, dot + 1) + s.slice(dot + 1).replace(/\./g, '').slice(0, max);
      input.value = s;
      usdtExact = unit === 'USDT' ? parse(s) : parse(s) * price;
      update();
    });
  });
</script>
