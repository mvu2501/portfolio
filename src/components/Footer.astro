---
// Footer.astro – cụm Contact (tiêu đề, email, link mạng xã hội) nằm tách riêng phía trên, rồi tới thanh cuối trang (Back to top, bản quyền).

// THAY: email thật của bạn
const email = 'mvu2501@gmail.com';

// THAY: link mạng xã hội thật. Xóa dòng nào bạn không dùng, thêm dòng mới nếu cần.
const socials = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/vu-nguyen-7b291094' },
  { label: 'Dribbble', href: 'https://dribbble.com/mvu2501' },
];

const year = new Date().getFullYear();
---

<section class="contact" id="contact">
  <div class="container contact__inner">
    <div>
      <h2 class="contact__title">Say hello.</h2>
      <div class="contact__mail">
        <a class="contact__email" href={`mailto:${email}`}>{email}</a>
        <button class="contact__copy" type="button" data-copy={email} aria-label="Copy email address">
          <svg class="contact__copy-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="9" y="9" width="11" height="11" rx="2" />
            <path d="M5 15V6a2 2 0 0 1 2-2h9" />
          </svg>
          <span class="contact__copied" role="status" aria-live="polite"></span>
        </button>
      </div>
    </div>

    <div class="contact__elsewhere">
      <p class="eyebrow">Elsewhere</p>
      <ul class="contact__socials">
        {socials.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener"><span>{s.label}</span><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4.5 11.5l7-7M5.5 4.5h6v6" /></svg></a></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__copy">© {year} vunguyen.me</p>
    <a class="button button--ghost" href="#top">↑ Back to top</a>
  </div>
</footer>

<script>
  // Nút copy email: sao chép vào clipboard và báo "Copied" trong 1,5 giây.
  document.querySelectorAll<HTMLButtonElement>('.contact__copy').forEach((btn) => {
    const note = btn.querySelector<HTMLElement>('.contact__copied');
    btn.addEventListener('click', async () => {
      const text = btn.dataset.copy ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // Trình duyệt chặn clipboard: chọn sẵn nội dung email để người xem tự copy
        const link = document.querySelector('.contact__email');
        if (link) window.getSelection()?.selectAllChildren(link);
      }
      if (note) {
        note.textContent = 'Copied';
        window.setTimeout(() => (note.textContent = ''), 1500);
      }
    });
  });
</script>

<style>
  .contact {
    padding-top: var(--space-5);
    padding-bottom: var(--space-4);
  }

  .contact__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact__title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-heading);
    line-height: 1.1;
  }

  .contact__email {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 400;
    font-style: italic;
    font-size: 1.5rem;
    letter-spacing: var(--tracking-display);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    word-break: break-all;
  }

  .contact__email:hover {
    text-decoration-thickness: 2px;
  }

  .contact__mail {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .contact__copy {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 6px;
    border: 0;
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .contact__copy:hover {
    color: var(--color-text);
    background: var(--color-tint);
  }

  .contact__copied {
    position: absolute;
    left: calc(100% + 4px);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text-muted);
  }

  .contact__socials {
    list-style: none;
    margin: var(--space-1) 0 0;
    padding: 0;
    max-width: 18rem;
  }

  .contact__socials a {
    display: flex;
    justify-content: space-between;
    padding-block: var(--space-1);
    border-bottom: 1px solid var(--color-tint-strong);
    text-decoration: none;
    font-size: var(--text-lg);
  }

  .contact__socials a {
    align-items: center;
  }

  .contact__socials a:hover {
    color: var(--color-text-muted);
  }

  .footer {
    padding-block: var(--space-4) 22px;
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-tint-strong);
  }

  .footer__copy {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .contact__inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }

    .contact__elsewhere {
      min-width: 16rem;
      padding-top: var(--space-2);
    }

    .footer__inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
