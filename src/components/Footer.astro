---
// Footer.astro – cụm Contact (tiêu đề, email, link mạng xã hội) nằm tách riêng phía trên, rồi tới thanh cuối trang (Back to top, bản quyền).

// THAY: email thật của bạn
const email = 'mvu2501@gmail.com';

// THAY: link mạng xã hội thật. Xóa dòng nào bạn không dùng, thêm dòng mới nếu cần.
const socials = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/vu-nguyen-7b291094' },
  { label: 'Dribbble', href: 'https://dribbble.com/mvu2501' },
];

const year = new Date().getFullYear();
---

<section class="contact" id="contact">
  <div class="container contact__inner">
    <div>
      <h2 class="contact__title">Say hello.</h2>
      <a class="contact__email" href={`mailto:${email}`}>{email}<span aria-hidden="true"> ↗</span></a>
    </div>

    <div class="contact__elsewhere">
      <p class="eyebrow">Elsewhere</p>
      <ul class="contact__socials">
        {socials.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener"><span>{s.label}</span><span aria-hidden="true">↗</span></a></li>
        ))}
      </ul>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__copy">© {year} vunguyen.me</p>
    <a class="button button--ghost" href="#top">↑ Back to top</a>
  </div>
</footer>

<style>
  .contact {
    padding-top: var(--space-5);
    padding-bottom: var(--space-4);
  }

  .contact__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact__title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-display);
    line-height: 1.1;
  }

  .contact__email {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: var(--text-heading);
    letter-spacing: var(--tracking-display);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
    word-break: break-all;
  }

  .contact__email:hover {
    text-decoration-thickness: 2px;
  }

  .contact__socials {
    list-style: none;
    margin: var(--space-1) 0 0;
    padding: 0;
    max-width: 18rem;
  }

  .contact__socials a {
    display: flex;
    justify-content: space-between;
    padding-block: var(--space-1);
    border-bottom: 1px solid var(--color-tint-strong);
    text-decoration: none;
    font-size: var(--text-lg);
  }

  .contact__socials a:hover {
    color: var(--color-text-muted);
  }

  .footer {
    padding-block: var(--space-4) 22px;
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-tint-strong);
  }

  .footer__copy {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .contact__inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }

    .contact__elsewhere {
      min-width: 16rem;
      padding-top: var(--space-2);
    }

    .footer__inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
