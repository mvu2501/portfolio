---
// OrderTypesMockup.astro – mockup điện thoại tương tác "Order types" (phần Design Decisions › Solution, case study Trading).
// Chỉ Order form tương tác (src/scripts/order-types.ts dựng form bên trong #fh / #fb);
// status bar, tab Spot/Convert/OTC, tiêu đề cặp, biểu đồ và thanh điều hướng giữ nguyên và `inert`.
// Nguồn: order-types-mockup.html (Figma "Aura Mobile v1.1", node 47:34916).
import '../../styles/mockup-frame.css';
import '../../styles/order-types.css';
import MockupHead from '../MockupHead.astro';
import { CANDLES } from '../../lib/order-types/chart.ts';

interface Props {
  /** Dùng để đặt id duy nhất khi có nhiều mockup trên một trang */
  id?: string;
  /** Tiêu đề hiện phía trên khung xám */
  title?: string;
}
const { id = 'order-types', title = 'Placing an order' } = Astro.props;

const GRID = [8, 43, 78, 113, 148];
const Y_LABELS: [number, number, string][] = [
  [353, 10, '66,717.0'],
  [350, 45, '65,928.0'],
  [352, 80, '65,139.0'],
  [349, 115, '64,349.0'],
  [349, 150, '63,560.0'],
];
---

<div class="mf ot wide" data-order-types>
  <MockupHead icon="trade" title={title}>
    <p class="mf-cap">Interactive prototype</p>
  </MockupHead>
  <div class="mf-panel">
  <div class="stage" data-ot="stage">
    <div class="phone" data-ot="phone" role="group" aria-label="Aura Trade, Spot screen prototype">
      <div class="screen" data-ot="screen">
        <div class="status" inert>
          <span>9:41</span>
          <svg width="78" height="22" viewBox="0 0 78 22" aria-hidden="true"><g fill="#101214"><rect x="0" y="12" width="3.6" height="5" rx="1"/><rect x="5" y="9" width="3.6" height="8" rx="1"/><rect x="10" y="6" width="3.6" height="11" rx="1"/><rect x="15" y="3" width="3.6" height="14" rx="1"/></g><g fill="none" stroke="#101214" stroke-width="1.9" stroke-linecap="round"><path d="M27 8.4a10 10 0 0 1 14 0"/><path d="M29.6 11.4a6.2 6.2 0 0 1 8.8 0"/></g><circle cx="34" cy="15.2" r="1.7" fill="#101214"/><rect x="49.5" y="4.5" width="24" height="12" rx="3.6" fill="none" stroke="#101214" opacity=".4"/><rect x="51.3" y="6.3" width="20.4" height="8.4" rx="2.2" fill="#101214"/><path d="M75.2 8.6v4a2.1 2.1 0 0 0 0-4z" fill="#101214" opacity=".45"/></svg>
        </div>
        <div class="hdr" inert>
          <div class="tabs"><div class="tab on">Spot<i></i></div><div class="tab">Convert<i></i></div><div class="tab">OTC<i></i></div></div>
          <div class="pair"><b>BTC/USDT</b><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#101214" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg><em>+0.41%</em></div>
        </div>
        <div class="scroll" data-ot="scroll">
          <div class="chart" inert>
            <div class="tf"><span>Line</span><span>5m</span><span class="on">15m</span><span>30m</span><span>1H</span><span>4H</span><span>1D<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#66727f" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span></div>
            <div class="plot">
              {GRID.map((t) => <div class="g" style={`top:${t}px`}></div>)}
              {Y_LABELS.map(([l, t, text]) => <div class="y" style={`left:${l}px;top:${t}px`}>{text}</div>)}
              {CANDLES.map((c) => (
                <>
                  <div class={`c ${c[0]}`} style={`left:${c[1]}px;top:${c[2]}px;width:1px;height:${c[3]}px`}></div>
                  <div class={`c ${c[0]}`} style={`left:${c[4]}px;top:${c[5]}px;width:6.6px;height:${c[6]}px`}></div>
                </>
              ))}
              <div class="dash"></div><div class="tag">66,237.0</div>
            </div>
          </div>
          <div class="form" data-ot="form"><div class="fcol" data-ot="fh"></div><div class="fcol" data-ot="fb"></div></div>
        </div>
        <nav class="nav" inert aria-hidden="true">
          <div class="ni"><svg width="24" height="24" viewBox="0 0 24 24"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>Home</div>
          <div class="ni"><svg width="24" height="24" viewBox="0 0 24 24"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"/><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"/></svg>Assets</div>
          <div class="ni on"><svg width="24" height="24" viewBox="0 0 24 24"><circle cx="12" cy="12" r="12" fill="#101214" stroke="none"/><g transform="translate(5 5) scale(.583)" stroke="#fff"><path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/></g></svg>Trade</div>
          <div class="ni"><svg width="24" height="24" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="m7 15 3.5-3.5 2.5 2.5 4-4.5"/><path d="M14 9.5h3V12"/></svg>Earn</div>
          <div class="ni"><svg width="24" height="24" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z"/></svg>Plan</div>
        </nav>
        <div class="scrim" data-ot="scrim"></div>
        <div class="sheet" data-ot="sheet" role="dialog" aria-modal="true" aria-labelledby={`${id}-sheet-title`}>
          <div class="handle"></div>
          <div class="sheet-title" role="heading" aria-level="3" id={`${id}-sheet-title`} data-ot="shT"></div>
          <div class="opts" data-ot="opts" role="radiogroup"></div>
        </div>
        <div class="sheet cfm" data-ot="cfm" role="dialog" aria-modal="true" aria-labelledby={`${id}-confirm-title`}>
          <div class="sheet-title" role="heading" aria-level="3" id={`${id}-confirm-title`} data-ot="cfT"></div>
          <div class="cfr" data-ot="cfr"></div>
          <div class="cfa"><button type="button" class="cbtn pri" data-ot="cfOk">Confirm</button><button type="button" class="cbtn sec" data-ot="cfNo">Cancel</button></div>
        </div>
        <div class="toast" data-ot="toast" role="status" aria-live="polite"></div>
      </div>
    </div>
  </div>
  </div>
</div>

<script>
  import { initOrderTypes } from '../../scripts/order-types.ts';
  document.querySelectorAll<HTMLElement>('[data-order-types]').forEach((el) => initOrderTypes(el));
</script>
