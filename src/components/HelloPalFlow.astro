---
// HelloPalFlow.astro – sơ đồ động "hello PAL flow architecture" (case study hello PAL, mục Research).
// Nguồn: hello-pal-flow.html. Style, khối HTML và script giữ nguyên; chỉ thêm class "wide" (cho rộng hết cột bài)
// và data-theme="light" (trang luôn sáng nên sơ đồ không đổi sang nền tối theo máy người xem).
// Muốn đổi màu: sửa các biến CSS ở đầu ".occ-flow". Chèn vào bài bằng dòng <!-- demo:hello-pal-flow --> trong file .md.
---

<section class="occ-flow wide" data-occ-flow data-theme="light">
  <p class="eyebrow">Research · Flow architecture</p>
  <h3>hello PAL: how minting, sharing and referral connect</h3>
  <p class="lede">The campaign flow behind the site, from minting a PAL ID Card to sharing stickers and earning rewards. Pick a step, or let it play.</p>

  <div class="controls" role="group" aria-label="Flow steps"></div>
  <div class="caption" aria-live="polite">
    <div class="swap"><h4></h4><p></p></div>
    <div class="progress"></div>
  </div>

  <div class="legend">
    <span><i class="g"></i>Leaderboard 1 / reward</span>
    <span><i class="p"></i>Leaderboard 2 / sticker download</span>
    <span><i class="r"></i>Transaction or reward drop</span>
  </div>

  <div class="stage">
    <svg viewBox="0 0 1280 1210" role="img" aria-labelledby="occ-title occ-desc">
      <title id="occ-title">hello PAL flow architecture</title>
      <desc id="occ-desc">Web dapp flow from Vault wallet and PAL ID Card minting, through token-gated sticker creation, Telegram sync, sharing on X.com and Telegram, random rewards, referral, purchase and leaderboards.</desc>
      <defs>
        <marker id="occ-head" markerWidth="9" markerHeight="9" refX="8" refY="4.5" orient="auto" markerUnits="userSpaceOnUse">
          <path class="mk" d="M0,0 L9,4.5 L0,9 z" />
        </marker>
      </defs>
    </svg>
  </div>
  <p class="hint">Swipe sideways to see the full diagram.</p>
</section>

<style is:global>
  /* ---------- component styles (all scoped to .occ-flow) ---------- */
  .occ-flow {
    --ink: #1b1b1f; --muted: #5e5e68; --line: #2b2b33; --card: #ffffff;
    --zoneA: #ffe6d6; --zoneB: #c2e9f6;
    --green: #a9f2cb; --green-ink: #0e7a44;
    --purple: #ebd2ff; --purple-ink: #7a1fd1;
    --yellow: #f6fbc8;
    --arrow: #e5484d; --focus: #6d5ef5; --panel: #ffffff; --panel-line: #e4e2de;
    max-width: 1240px; margin: 0 auto; color: var(--ink);
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    .occ-flow:not([data-theme="light"]) {
      --ink: #f2f2f5; --muted: #a6a6b2; --line: #7a7a88; --card: #1f1f26;
      --zoneA: #3a2a22; --zoneB: #1f3540;
      --green: #1e5a41; --green-ink: #7df0b2;
      --purple: #43285f; --purple-ink: #d6a8ff;
      --yellow: #4a4b27;
      --arrow: #ff6b6f; --focus: #9b90ff; --panel: #1a1a20; --panel-line: #2c2c35;
    }
  }
  .occ-flow[data-theme="dark"] {
    --ink: #f2f2f5; --muted: #a6a6b2; --line: #7a7a88; --card: #1f1f26;
    --zoneA: #3a2a22; --zoneB: #1f3540;
    --green: #1e5a41; --green-ink: #7df0b2;
    --purple: #43285f; --purple-ink: #d6a8ff;
    --yellow: #4a4b27;
    --arrow: #ff6b6f; --focus: #9b90ff; --panel: #1a1a20; --panel-line: #2c2c35;
  }

  .occ-flow * { box-sizing: border-box; }
  .occ-flow .eyebrow { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin: 0 0 6px; }
  .occ-flow h3 { font-size: clamp(22px, 3vw, 30px); line-height: 1.2; margin: 0 0 6px; font-weight: 650; }
  .occ-flow .lede { margin: 0 0 20px; color: var(--muted); font-size: 15px; line-height: 1.5; max-width: 62ch; }

  .occ-flow .controls { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-bottom: 14px; }
  .occ-flow .chip {
    appearance: none; border: 1px solid var(--panel-line); background: var(--panel); color: var(--ink);
    font: inherit; font-size: 13px; padding: 7px 12px; border-radius: 999px; cursor: pointer;
    transition: background .2s, border-color .2s, transform .2s;
  }
  .occ-flow .chip:hover { border-color: var(--focus); transform: translateY(-1px); }
  .occ-flow .chip[aria-pressed="true"] { background: var(--focus); border-color: var(--focus); color: #fff; }
  .occ-flow .chip:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .occ-flow .chip .n { opacity: .65; margin-right: 5px; font-variant-numeric: tabular-nums; }
  .occ-flow .play { margin-left: auto; font-weight: 600; }

  .occ-flow .caption {
    position: relative; overflow: hidden; background: var(--panel); border: 1px solid var(--panel-line);
    border-radius: 14px; padding: 16px 18px 20px; margin-bottom: 14px; min-height: 104px;
  }
  .occ-flow .caption h4 { margin: 0 0 6px; font-size: 16px; font-weight: 650; }
  .occ-flow .caption p { margin: 0; color: var(--muted); font-size: 14.5px; line-height: 1.55; max-width: 90ch; }
  .occ-flow .caption .swap { animation: occ-swap .45s ease both; }
  .occ-flow .progress { position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background: var(--focus); transform-origin: left; transform: scaleX(0); }
  .occ-flow .progress.run { animation: occ-progress var(--dur, 5000ms) linear forwards; }
  @keyframes occ-swap { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes occ-progress { to { transform: scaleX(1); } }

  .occ-flow .legend { display: flex; flex-wrap: wrap; gap: 14px; font-size: 12.5px; color: var(--muted); margin: 0 0 10px; }
  .occ-flow .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .occ-flow .legend i { width: 12px; height: 12px; border-radius: 3px; display: inline-block; border: 1px solid var(--line); }
  .occ-flow .legend i.g { background: var(--green); } .occ-flow .legend i.p { background: var(--purple); }
  .occ-flow .legend i.r { background: none; border: 0; border-top: 2px dashed var(--arrow); border-radius: 0; height: 0; width: 18px; }

  .occ-flow .stage { overflow-x: auto; border-radius: 16px; border: 1px solid var(--panel-line); background: var(--panel); -webkit-overflow-scrolling: touch; }
  .occ-flow .stage svg { display: block; width: 100%; min-width: 920px; height: auto; }
  .occ-flow .hint { display: none; font-size: 12px; color: var(--muted); margin: 8px 2px 0; }
  @media (max-width: 960px) { .occ-flow .hint { display: block; } }

  /* ---------- svg parts ---------- */
  .occ-flow svg text { font-family: inherit; fill: var(--ink); }
  .occ-flow svg .t { font-size: 13px; font-weight: 650; }
  .occ-flow svg .s { font-size: 11px; fill: var(--muted); }
  .occ-flow svg .zlabel { font-size: 14px; font-weight: 650; }
  .occ-flow svg .zone rect { stroke: none; }
  .occ-flow svg .zone.a rect { fill: var(--zoneA); }
  .occ-flow svg .zone.b rect { fill: var(--zoneB); }

  .occ-flow svg .node rect { fill: var(--card); stroke: var(--line); stroke-width: 1.2; transition: stroke .3s, stroke-width .3s; }
  .occ-flow svg .node.k-green rect { fill: var(--green); }
  .occ-flow svg .node.k-purple rect { fill: var(--purple); }
  .occ-flow svg .node.k-yellow rect { fill: var(--yellow); }
  .occ-flow svg .node.k-green .t { fill: var(--green-ink); }
  .occ-flow svg .node.k-purple .t { fill: var(--purple-ink); }
  .occ-flow svg .node .face-head { fill: #fff; stroke: #2b2b33; stroke-width: 1.2; }
  .occ-flow svg .node .face-eye { fill: #35b3f0; }

  .occ-flow svg .node, .occ-flow svg .arrow, .occ-flow svg .zone {
    transform-box: fill-box; transform-origin: center; transition: opacity .35s ease, transform .35s ease;
  }
  .occ-flow svg.focus .node:not(.on), .occ-flow svg.focus .arrow:not(.on) { opacity: .22; }
  .occ-flow svg .node.on { transform: translateY(-2px); }
  .occ-flow svg .node.on rect { stroke: var(--focus); stroke-width: 2.6; }
  .occ-flow svg .node.on:not(.c) rect { filter: drop-shadow(0 6px 10px rgba(109, 94, 245, .35)); }

  .occ-flow svg .arrow path.line { fill: none; stroke: var(--arrow); stroke-width: 1.6; stroke-dasharray: 5 5; marker-end: url(#occ-head); animation: occ-dash 1.3s linear infinite; }
  .occ-flow svg .arrow.on path.line { stroke-width: 2.4; animation-duration: .7s; }
  .occ-flow svg .arrow text { font-size: 10.5px; fill: var(--arrow); }
  .occ-flow svg .arrow .dot { fill: var(--arrow); display: none; }
  .occ-flow svg .arrow.on .dot { display: block; }
  .occ-flow svg .mk { fill: var(--arrow); }
  @keyframes occ-dash { to { stroke-dashoffset: -20; } }

  /* entrance */
  .occ-flow svg.reveal .node, .occ-flow svg.reveal .arrow, .occ-flow svg.reveal .zone {
    animation: occ-pop .55s cubic-bezier(.2, .8, .2, 1) backwards; animation-delay: var(--d, 0ms);
  }
  @keyframes occ-pop { from { opacity: 0; transform: translateY(10px) scale(.97); } }

  @media (prefers-reduced-motion: reduce) {
    .occ-flow svg .arrow path.line { animation: none; }
    .occ-flow svg.reveal .node, .occ-flow svg.reveal .arrow, .occ-flow svg.reveal .zone { animation: none; }
    .occ-flow .caption .swap, .occ-flow .progress.run { animation: none; }
    .occ-flow svg .arrow .dot { display: none !important; }
  }

  /* Thêm: cột bài hẹp hơn sơ đồ (min-width 920px) từ màn hình dưới 1360px nên cần gợi ý cuộn ngang */
  @media (max-width: 1360px) { .occ-flow .hint { display: block; } }
</style>

