  /* ---------- helpers ---------- */
  function el(tag, attrs, parent) {
    var e = document.createElementNS(NS, tag);
    for (var k in attrs) e.setAttribute(k, attrs[k]);
    if (parent) parent.appendChild(e);
    return e;
  }
  function txt(parent, x, y, str, cls, anchor) {
    var t = el("text", { x: x, y: y, "text-anchor": anchor || "middle", "class": cls || "" }, parent);
    t.textContent = str;
    return t;
  }
  function face(g, cx, cy, s) {
    el("polygon", { "class": "face-head", points: [cx - 0.95 * s, cy - 0.35 * s, cx - 0.8 * s, cy - 1.15 * s, cx - 0.2 * s, cy - 0.75 * s].join(" ") }, g);
    el("polygon", { "class": "face-head", points: [cx + 0.95 * s, cy - 0.35 * s, cx + 0.8 * s, cy - 1.15 * s, cx + 0.2 * s, cy - 0.75 * s].join(" ") }, g);
    el("ellipse", { "class": "face-head", cx: cx, cy: cy, rx: 1.15 * s, ry: 0.92 * s }, g);
    el("circle", { "class": "face-eye", cx: cx - 0.42 * s, cy: cy - 0.05 * s, r: 0.2 * s }, g);
    el("circle", { "class": "face-eye", cx: cx + 0.42 * s, cy: cy - 0.05 * s, r: 0.2 * s }, g);
  }

  function init(root) {
    var svg = root.querySelector("svg");
    var controls = root.querySelector(".controls");
    var capWrap = root.querySelector(".caption .swap");
