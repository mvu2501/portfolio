      var g = el("g", { "class": "node k-" + n.k + (n.c ? " c" : "") }, svg);
      tag(g, n.st, 200 + i * 28);
      el("rect", { x: n.x, y: n.y, width: n.w, height: n.h, rx: n.c ? 14 : 10 }, g);
      var cx = n.x + n.w / 2, y;
      var tl = n.t || [], sl = n.s || [];
      if (n.c) {
        y = n.y + 23;
        tl.forEach(function (l) { txt(g, cx, y, l, "t"); y += 16; });
        y = n.sy ? n.y + n.sy : y + 2;
        sl.forEach(function (l) { txt(g, cx, y, l, "s"); y += 14; });
        if (n.art) face(g, cx, n.y + n.artY, n.art);
      } else if (n.top) {
        txt(g, cx, n.y + 20, tl[0], "t");
        if (n.art) face(g, cx, n.y + n.h * 0.64, n.art);
      } else {
        var total = tl.length * 15 + sl.length * 14;
        y = n.y + n.h / 2 - total / 2 + 11;
        tl.forEach(function (l) { txt(g, cx, y, l, "t"); y += 15; });
        sl.forEach(function (l) { txt(g, cx, y, l, "s"); y += 14; });
      }
    });

    /* arrows (drawn after nodes so heads sit on top) */
    A.forEach(function (a, i) {
      var g = el("g", { "class": "arrow" }, svg);
      tag(g, a.st, 700 + i * 45);
      el("path", { "class": "line", d: a.d }, g);
      var dot = el("circle", { "class": "dot", r: 4.5 }, g);
      el("animateMotion", { path: a.d, dur: "1.8s", repeatCount: "indefinite" }, dot);
      if (a.l) a.l.forEach(function (line, j) { txt(g, a.lx, a.ly + j * 12, line, "", a.anchor); });
    });

    /* controls */
    function chip(label, n) {
      var b = document.createElement("button");
      b.type = "button"; b.className = "chip"; b.setAttribute("aria-pressed", "false");
      b.innerHTML = (n ? '<span class="n">' + n + "</span>" : "") + label;
      b.addEventListener("click", function () { playing = false; syncPlay(); select(n); });
      controls.appendChild(b); chips.push(b);
    }
    chip("All", 0);
    STEPS.forEach(function (s, i) { chip(s.short, i + 1); });
    var playBtn = document.createElement("button");
    playBtn.type = "button"; playBtn.className = "chip play";
    playBtn.addEventListener("click", function () {
      playing = !playing; syncPlay();
      if (playing) { select(current === 0 ? 1 : current); }
    });
    controls.appendChild(playBtn);
    function syncPlay() {
      playBtn.textContent = playing ? "Pause" : "Play";
      playBtn.setAttribute("aria-pressed", String(playing));
      if (!playing) progress.classList.remove("run");
    }

    function select(n) {
      current = n;
      chips.forEach(function (c, i) { c.setAttribute("aria-pressed", String(i === n)); });
      var all = svg.querySelectorAll("[data-st]");
      if (n === 0) {
        svg.classList.remove("focus");
        all.forEach(function (g) { g.classList.remove("on"); });
        capTitle.textContent = "The whole flow";
        capText.textContent = "From minting a PAL ID Card on the web dapp, through sticker creation and sharing, to rewards, referral and leaderboards on Telegram and X.com.";
      } else {
        svg.classList.add("focus");
        all.forEach(function (g) { g.classList.toggle("on", g.getAttribute("data-st").indexOf("," + n + ",") > -1); });
        capTitle.textContent = n + ". " + STEPS[n - 1].title;
        capText.textContent = STEPS[n - 1].text;
      }
      capWrap.classList.remove("swap"); void capWrap.offsetWidth; capWrap.classList.add("swap");
      progress.classList.remove("run"); void progress.offsetWidth;
      if (playing && n > 0) { progress.style.setProperty("--dur", STEP_MS + "ms"); progress.classList.add("run"); }
    }

    function tick() {
      if (!playing || !visible) return;
      select(current >= STEPS.length ? 1 : current + 1);
    }

    syncPlay();
    select(0);

    /* start when scrolled into view */
    var started = false;
    function onVisible() {
      if (started) return; started = true;
      svg.classList.add("reveal");
      if (playing) setTimeout(function () { if (playing) select(1); }, 1800);
      timer = setInterval(tick, STEP_MS);
    }
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { visible = e.isIntersecting; if (visible) onVisible(); });
      }, { threshold: 0.3 }).observe(svg);
    } else { visible = true; onVisible(); }
  }

  document.querySelectorAll("[data-occ-flow]").forEach(init);
})();
</script>
