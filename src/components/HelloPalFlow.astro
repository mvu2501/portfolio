    var capText = capWrap.querySelector("p");
    var progress = root.querySelector(".progress");
    var chips = [];
    var current = 0, playing = !reduced, visible = false, timer = null, order = 0;

    function tag(g, steps, delay) {
      g.setAttribute("data-st", "," + steps.join(",") + ",");
      g.style.setProperty("--d", delay + "ms");
    }

    /* zones */
    var zA = el("g", { "class": "zone a" }, svg);
    el("rect", { x: 20, y: 60, width: 1240, height: 690, rx: 20 }, zA);
    txt(zA, 44, 92, "Web dapp · epic.gall3ry.io/PAL", "zlabel", "start");
    zA.style.setProperty("--d", "0ms");
