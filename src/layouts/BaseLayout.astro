---
// BaseLayout.astro – "khung chung" bọc quanh mọi trang.
// Nó lo phần <head> (tiêu đề, font, CSS) rồi đặt nội dung từng trang vào <slot />.
// Thanh Nav ở trên và Footer ở dưới được đặt ở đây nên xuất hiện trên mọi trang.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'vunguyen.me',
  // THAY: mô tả ngắn hiện trên Google khi ai đó tìm tên bạn
  description = 'Senior Product Designer · 10+ years building fintech and digital asset products',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Biểu tượng tab (favicon): chữ V. SVG cho trình duyệt hiện đại, .ico dự phòng, PNG cho iPhone -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Màn hình loading: chỉ chạy ở lần xem đầu của mỗi phiên, và bỏ qua nếu người dùng tắt chuyển động.
         Chạy ngay trong <head> để trang không bị nháy nội dung trước khi màn hình loading hiện. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (reduce || sessionStorage.getItem('loaderSeen')) return;
          sessionStorage.setItem('loaderSeen', '1');
        } catch (e) {}
        root.classList.add('is-loading');
        function done() {
          root.classList.remove('is-loading');
          document.removeEventListener('animationend', onEnd);
        }
        // Gỡ lớp đúng lúc nội dung hiện xong (hoạt ảnh cuối cùng của màn hình loading)
        function onEnd(e) {
          if (e.animationName === 'loader-content-in' && e.target.tagName === 'MAIN') done();
        }
        document.addEventListener('animationend', onEnd);
        // Phương án dự phòng nếu sự kiện trên không chạy
        setTimeout(done, 6000);
      })();
    </script>

    <!-- Font Inter Tight (chữ thường), JetBrains Mono (nút, nhãn, tag) và Inter (order form trong case study Trading) từ Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body id="top">
    <Loader />
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
